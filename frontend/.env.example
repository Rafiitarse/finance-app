# API URL — used by the Next.js route handlers (BFF) server-side.
# NEXT_PUBLIC_ vars are compiled into the client bundle, so the Django URL is
# only used by the server; prefer BACKEND_API_URL (server-only) in production.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# BACKEND_API_URL=http://localhost:8000/api
