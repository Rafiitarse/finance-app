# Django — core
# DEBUG defaults to 0. When DEBUG=0 the app FAILS FAST unless SECRET_KEY and
# ALLOWED_HOSTS are set to secure values (no django-insecure- prefix).
DEBUG=1
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_db
DB_USER=root
DB_PASSWORD=root

# CORS — the frontend authenticates with the Authorization header, so
# credentials are not needed (CORS_ALLOW_CREDENTIALS is False).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production security (only meaningful when DEBUG=0; safe defaults are on)
# SECURE_SSL_REDIRECT=1
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# Set to 1 when running behind a proxy that terminates TLS (Railway/Render).
# BEHIND_PROXY=1

# API documentation — exposed only when DEBUG=1 or this is set to 1
# ENABLE_API_DOCS=1

# Throttling rates (DRF)
# THROTTLE_ANON_RATE=60/min
# THROTTLE_USER_RATE=300/min
# THROTTLE_AUTH_RATE=10/min

# Entrypoint behavior
# RUN_MIGRATIONS=1
# WEB_CONCURRENCY=3
